# Hyperstack API key (from https://console.hyperstack.cloud)
HYPERSTACK_API_KEY=281e8c01-f598-44bb-a10f-03565621312f

# Hyperstack VM configuration
HYPERSTACK_ENVIRONMENT=test
# Common GPU Flavors (Canada/Norway regions):
# - n3-RTX-A6000x1
# - n3-RTX-A6000x1-spot
# - n3-L40x1
# - n3-H100x1
# - n3-A100-SXM4x8
# Common CPU Flavors (for testing):
# - n1-cpu-small
# - n1-cpu-medium
HYPERSTACK_FLAVOR=n3-L40x1-spot
HYPERSTACK_IMAGE="Ubuntu Server 22.04 LTS R535 CUDA 12.2 with Docker"
HYPERSTACK_KEY_NAME=nndl_key_r15i
HYPERSTACK_REGION=CANADA-1

# SSH key (path to your private key for accessing the Hyperstack VM)
SSH_PRIVATE_KEY_PATH=~/.ssh/id_ed25519

DOCKERHUB_USERNAME=r15i
DOCKERHUB_TOKEN=toCHange

