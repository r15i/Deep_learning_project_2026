# ──────────────────────────────────────────────────────────────────────
# .env.example — Copy to .env and fill in your values
# ──────────────────────────────────────────────────────────────────────

# Hyperstack API key (from https://console.hyperstack.cloud)
HYPERSTACK_API_KEY=your_hyperstack_api_key_here

# Hyperstack VM configuration
HYPERSTACK_ENVIRONMENT=your_environment_name
# Common GPU Flavors (Canada/Norway regions):
# - n3-RTX-A6000x1
# - n3-RTX-A6000x1-spot
# - n3-L40x1
# - n3-H100x1
# - n3-A100-SXM4x8
# Common CPU Flavors (for testing):
# - n1-cpu-small
# - n1-cpu-medium
HYPERSTACK_FLAVOR=n3-RTX-A6000x1-spot
HYPERSTACK_IMAGE="Ubuntu Server 22.04 LTS R535 CUDA 12.2 with Docker"
HYPERSTACK_KEY_NAME=your_ssh_key_name
HYPERSTACK_REGION=CANADA-1

# SSH key (path to your private key for accessing the Hyperstack VM)
SSH_PRIVATE_KEY_PATH=~/.ssh/id_rsa

# DockerHub Configuration (for pushing images)
DOCKERHUB_USERNAME=your_dockerhub_username
DOCKERHUB_TOKEN=your_dockerhub_personal_access_token

# Weights & Biases Configuration (for metric tracking and sweeps)
WANDB_API_KEY=your_wandb_api_key_here
